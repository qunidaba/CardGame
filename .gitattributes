# 默认自动识别文本/二进制，文本统一按仓库内 LF 存储
* text=auto eol=lf

# Unity 文本资源：标记为文本（便于 diff）
*.cs        text diff=csharp
*.shader    text
*.json      text
*.txt       text
*.md        text
*.xml       text
*.meta      text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.anim      text
*.controller text
*.overrideController text
*.asmdef    text
# 二进制资源（不做行尾转换、不做 diff）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.psd       binary
*.gif       binary
*.exr       binary
*.hdr       binary
*.ttf       binary
*.otf       binary
*.ttc       binary
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.fbx       binary
*.dll       binary
*.so        binary
*.aar       binary
*.jar       binary
# 大字体资产走 LFS（移动到 GameRes 后的路径）
Assets/GameRes/Fonts/simhei[[:space:]]SDF.asset filter=lfs diff=lfs merge=lfs -text
